# Used by the collector CLI and the FastAPI backend (uvicorn run from the repo root).
SUPABASE_URL=https://your-project.supabase.co
# Server-side service-role/secret key. Never put it in the dashboard or any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-or-sb_secret_key
# Optional: lets the API verify sessions with the anon key instead of the service key.
SUPABASE_ANON_KEY=your-anon-key
# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=StartupFundingCollector/1.0 your-name your-email@example.com

# Comma-separated emails that are always administrators (how you get your first admin).
ADMIN_EMAILS=you@example.com
# Origins allowed to call the API directly (the dashboard normally goes through its own proxy).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Parallel companies per enrichment job.
ENRICH_WORKERS=6
# Optional: Brave Search API key (paid API with a small monthly credit), used only when keyless discovery finds nothing.
# BRAVE_SEARCH_API_KEY=
